{
  "name": "@local/dsh-session-git-sync",
  "version": "1.0.2",
  "private": true,
  "description": "Sync DSH Session history between computers through a Git repository.",
  "type": "module",
  "author": "AmosIscr",
  "license": "MIT",
  "homepage": "https://github.com/AmosIscr/dsh-session-git-sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmosIscr/dsh-session-git-sync.git"
  },
  "bugs": {
    "url": "https://github.com/AmosIscr/dsh-session-git-sync/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "git",
    "sync"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/core.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}